{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dzmm",
  "version": "0.1.0",
  "identifier": "com.dzmm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "dzmm",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "resources": [
      "backend-runtime/*",
      "backend-runtime/_internal/**/*",
      "../dist/*",
      "../dist/assets/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/b31o8321/dzmm/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "active": true,
      "dialog": false
    }
  }
}
