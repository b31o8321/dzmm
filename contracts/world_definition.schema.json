{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dzmm.local/contracts/world-definition/2026-08-17-content-boundary",
  "title": "WorldDefinition",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "lorebook",
    "character_cards",
    "locations",
    "factions",
    "npcs",
    "events",
    "resources",
    "ruleset",
    "story"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "lorebook": {
      "$ref": "#/$defs/lorebook"
    },
    "character_cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/characterCard"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "factions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "ruleset": {
      "$ref": "#/$defs/ruleset"
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "loop_config": {
      "type": "object",
      "required": [
        "max_loops"
      ],
      "properties": {
        "max_loops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "trigger": {
          "type": "array",
          "items": {
            "enum": [
              "time",
              "death",
              "manual"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "time_system": {
      "type": "object",
      "required": [
        "start_minutes"
      ],
      "properties": {
        "start_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "loop_at_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "per_turn_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "unit": {
          "type": "string",
          "maxLength": 10
        }
      },
      "additionalProperties": false
    },
    "clock_config": {
      "type": "object",
      "required": [
        "tick_per_turn"
      ],
      "properties": {
        "tick_per_turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "warn_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        }
      },
      "additionalProperties": false
    },
    "mystery": {
      "type": "object",
      "required": [
        "culprit_id",
        "required_clues"
      ],
      "properties": {
        "culprit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "required_clues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "max_accusations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "wrong_accusation_ending_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "legacy_config": {
      "type": "object",
      "required": [
        "boons"
      ],
      "properties": {
        "boons": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "世界自定义技能目录（与引擎基础集、已习得技能并集构成 skill_check 合法范围）"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "lorebook": {
      "type": "object",
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lorebookEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "lorebookEntry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "body",
        "activation",
        "priority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "activation": {
          "enum": [
            "always",
            "keyword"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "source": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "characterCard": {
      "type": "object",
      "required": [
        "id",
        "name",
        "format"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "native",
            "sillytavern_v3"
          ]
        },
        "mapped": {
          "type": "object"
        },
        "source_payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ruleset": {
      "type": "object",
      "required": [
        "id",
        "enabled_capabilities"
      ],
      "properties": {
        "id": {
          "enum": [
            "trpg",
            "story_adventure",
            "relationship_drama",
            "hybrid"
          ]
        },
        "enabled_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "trpg",
              "combat",
              "chapters",
              "choices",
              "relationships",
              "routes",
              "endings",
              "resources",
              "time",
              "loop",
              "countdown",
              "deduction",
              "roguelike"
            ]
          }
        },
        "combat_rules": {
          "type": "object",
          "properties": {
            "hero": {
              "type": "object",
              "properties": {
                "max_hp": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "ac": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 40
                },
                "attack_bonus": {
                  "type": "integer",
                  "minimum": -10,
                  "maximum": 50
                },
                "damage": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "sides": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 100
                    },
                    "bonus": {
                      "type": "integer",
                      "minimum": -10,
                      "maximum": 50
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "npc": {
              "type": "object",
              "properties": {
                "max_hp": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "ac": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 40
                },
                "attack_bonus": {
                  "type": "integer",
                  "minimum": -10,
                  "maximum": 50
                },
                "damage": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "sides": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 100
                    },
                    "bonus": {
                      "type": "integer",
                      "minimum": -10,
                      "maximum": 50
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "title",
        "order",
        "choices",
        "next_chapter_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storyChoice"
          }
        },
        "next_chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "storyChoice": {
      "type": "object",
      "required": [
        "id",
        "label",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storyEffect"
          }
        }
      },
      "additionalProperties": false
    },
    "storyEffect": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "set_story_flag",
            "apply_relationship_event",
            "grant_resource",
            "set_route"
          ]
        },
        "flag_id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "boolean"
        },
        "relationship_event_id": {
          "$ref": "#/$defs/id"
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "route_id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "storyFlag": {
      "type": "object",
      "required": [
        "id",
        "default",
        "writers"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "default": {
          "type": "boolean"
        },
        "writers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^choice:[a-z][a-z0-9_-]{0,63}$"
          }
        }
      },
      "additionalProperties": false
    },
    "relationshipDimension": {
      "type": "object",
      "required": [
        "initial",
        "min",
        "max"
      ],
      "properties": {
        "initial": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "min": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "max": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "character_card_id",
        "dimensions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "character_card_id": {
          "$ref": "#/$defs/id"
        },
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relationshipDimension"
          }
        },
        "visibility": {
          "enum": [
            "player",
            "hidden"
          ]
        }
      },
      "additionalProperties": false
    },
    "relationshipEvent": {
      "type": "object",
      "required": [
        "id",
        "relationship_id",
        "deltas",
        "reason_key",
        "once_scope",
        "cooldown_turns"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "relationship_id": {
          "$ref": "#/$defs/id"
        },
        "deltas": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          }
        },
        "reason_key": {
          "type": "string",
          "minLength": 1
        },
        "once_scope": {
          "enum": [
            "run",
            "chapter",
            "none"
          ]
        },
        "cooldown_turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ending": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "priority",
        "when",
        "narrative_key"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "good",
            "normal",
            "bad",
            "hidden"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "when": {
          "type": "object"
        },
        "narrative_key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "epitaph": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "campaignPhase": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "key_event_ids",
        "required_count"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "key_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "required_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "campaign": {
      "type": "object",
      "required": [
        "id",
        "name",
        "phases"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/campaignPhase"
          }
        }
      },
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "required": [
        "chapters",
        "flags",
        "relationships",
        "relationship_events",
        "routes",
        "endings"
      ],
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storyFlag"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "relationship_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationshipEvent"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "endings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ending"
          }
        },
        "campaign": {
          "$ref": "#/$defs/campaign"
        },
        "quests": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "completion",
              "rewards"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "completion": {
                "type": "object",
                "required": [
                  "flag"
                ],
                "properties": {
                  "flag": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "additionalProperties": false
              },
              "rewards": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "item",
                        "clue",
                        "skill"
                      ]
                    },
                    "item_id": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "skill": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "additionalProperties": false
                }
              },
              "requires_quest": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "任务链：前置任务完成后本任务才激活（pending→active）"
              },
              "deadline_turns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "description": "限时：激活后 N 回合内未完成则 expired（完成优先于过期）"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
