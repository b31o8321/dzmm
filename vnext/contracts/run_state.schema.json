{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dzmm.local/contracts/run-state/2026-08-17-content-boundary",
  "title": "RunState",
  "type": "object",
  "required": ["schema_version", "revision", "hero", "ruleset", "location_id", "inventory", "entities", "events", "chapter", "route", "flags", "relationships", "ending"],
  "properties": {
    "schema_version": {"const": 3},
    "revision": {"type": "integer", "minimum": 0},
    "hero": {"type": "object"},
    "narrative_context": {"type": "object", "required": ["run_seed", "turn_index", "recent_turns", "current_hook"], "properties": {"run_seed": {"type": "string", "minLength": 1}, "turn_index": {"type": "integer", "minimum": 0}, "recent_turns": {"type": "array", "maxItems": 6, "items": {"type": "object", "required": ["turn", "player_input", "narrative", "outcomes", "dialogues"], "properties": {"turn": {"type": "integer", "minimum": 0}, "player_input": {"type": "string"}, "narrative": {"type": "string"}, "outcomes": {"type": "array"}, "dialogues": {"type": "array", "items": {"type": "object", "required": ["speaker", "text"], "properties": {"speaker": {"type": "string"}, "text": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false}}, "current_hook": {"type": "object", "required": ["key", "directive", "turn"], "properties": {"key": {"type": "string"}, "directive": {"type": "string"}, "turn": {"type": "string"}}, "additionalProperties": false}}, "additionalProperties": false},
    "location_state": {"type": "object", "additionalProperties": {"type": "object", "required": ["known", "visited_turns", "last_visited_turn", "scene_state"], "properties": {"known": {"type": "boolean"}, "visited_turns": {"type": "array", "items": {"type": "integer", "minimum": 0}, "maxItems": 20}, "last_visited_turn": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "scene_state": {"type": "object"}}, "additionalProperties": false}},
    "npc_state": {"type": "object", "additionalProperties": {"type": "object", "required": ["id", "name", "met", "location_id", "state", "favor", "faction_id", "reputation", "emotion", "last_seen_turn", "last_spoke_turn", "last_initiative_turn", "cooldown_turns"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "met": {"type": "boolean"}, "location_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "state": {"type": "string"}, "favor": {"type": "integer", "minimum": -100, "maximum": 100}, "faction_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "reputation": {"type": "integer", "minimum": -100, "maximum": 100}, "emotion": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -100, "maximum": 100}}, "last_seen_turn": {"type": "integer", "minimum": 0}, "last_spoke_turn": {"type": "integer", "minimum": 0}, "last_initiative_turn": {"type": "integer", "minimum": 0}, "cooldown_turns": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "faction_state": {"type": "object", "additionalProperties": {"type": "object", "required": ["id", "name", "tension", "passive_gain_per_turn", "threshold_conflict", "last_advanced_turn"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "tension": {"type": "integer", "minimum": 0, "maximum": 100}, "passive_gain_per_turn": {"type": "integer", "minimum": 0, "maximum": 10}, "threshold_conflict": {"type": "integer", "minimum": 1, "maximum": 100}, "last_advanced_turn": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
    "campaign_state": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["id", "name", "current_phase_id", "completed_phase_ids", "completed_event_ids"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "current_phase_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "completed_phase_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "completed_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}]},
    "active_events": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "status", "introduced_turn"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "status": {"enum": ["active", "resolved", "triggered", "abandoned"]}, "subject": {"type": "string"}, "severity": {"type": "integer", "minimum": 1, "maximum": 5}, "description": {"type": "string"}, "consequence": {"type": "string"}, "introduced_turn": {"type": "integer", "minimum": 0}, "trigger_turn": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "resolved_turn": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "resolution": {"type": "string"}, "completion_conditions": {"type": "object"}, "campaign_phase_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "additionalProperties": false}},
    "plot_threads": {"type": "array", "items": {"type": "object", "required": ["id", "type", "description", "introduced_turn", "importance", "status", "resolution"], "properties": {"id": {"type": "string"}, "type": {"enum": ["quest", "hook", "mystery", "major_event"]}, "description": {"type": "string"}, "introduced_turn": {"type": "integer", "minimum": 0}, "importance": {"type": "integer", "minimum": 1, "maximum": 3}, "status": {"enum": ["active", "resolved", "abandoned"]}, "resolution": {"type": "string"}}, "additionalProperties": false}},
    "pending_interactions": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "npc_id", "npc_name", "location_id", "created_turn", "status", "instruction"], "properties": {"id": {"type": "string"}, "kind": {"const": "npc_initiative"}, "npc_id": {"type": "string"}, "npc_name": {"type": "string"}, "location_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "created_turn": {"type": "integer", "minimum": 0}, "status": {"const": "pending"}, "instruction": {"type": "string"}}, "additionalProperties": false}},
    "ruleset": {"type": "object", "required": ["id", "enabled_capabilities"], "properties": {"id": {"enum": ["trpg", "story_adventure", "relationship_drama", "hybrid"]}, "enabled_capabilities": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "location_id": {"type": "string"},
    "inventory": {"type": "array", "items": {"type": "object", "required": ["id", "quantity"], "properties": {"id": {"type": "string"}, "quantity": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "entities": {"type": "object"}, "events": {"type": "object"},
    "chapter": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["id", "status", "resolved_choice_ids"], "properties": {"id": {"type": "string"}, "status": {"enum": ["active", "completed"]}, "resolved_choice_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}]},
    "route": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"const": "locked"}}, "additionalProperties": false}]},
    "flags": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "relationships": {"type": "object", "additionalProperties": {"type": "object", "required": ["dimensions", "applied_events"], "properties": {"dimensions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -100, "maximum": 100}}, "applied_events": {"type": "object", "additionalProperties": {"type": "object", "required": ["turn_revision", "reason_key", "chapter_id", "cooldown_until_revision"], "properties": {"turn_revision": {"type": "integer", "minimum": 0}, "reason_key": {"type": "string"}, "chapter_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "cooldown_until_revision": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}}, "additionalProperties": false}}}, "additionalProperties": false}},
    "ending": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["id", "kind", "narrative_key"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["good", "normal", "bad", "hidden"]}, "narrative_key": {"type": "string"}}, "additionalProperties": false}]}
  }, "additionalProperties": false
}
